# Create a Market Data app at https://fyers.in/web/api-dashboard/user-apps
# Register this exact redirect URL in the FYERS app.
FYERS_APP_ID=
FYERS_SECRET_ID=
FYERS_REDIRECT_URI=http://127.0.0.1:5173/api/fyers/callback

# Optional: a manually generated token can bypass the local OAuth flow.
# The local OAuth connection stores its token in data/fyers-session.json instead.
FYERS_ACCESS_TOKEN=

# Optional. Keep this local; it enables refresh-token renewal when FYERS supports it.
# Never paste the PIN into the frontend or commit it to Git.
FYERS_PIN=

# Five-second REST snapshots are used for the dashboard and signal calculations.
MARKET_POLL_MS=5000
HISTORY_INTERVAL_MS=60000
HISTORY_RETENTION_DAYS=30
PORT=5173

# Signal thresholds are measured from the immutable first-suggested price.
SIGNAL_WARNING_PCT=-3
SIGNAL_INVALIDATED_PCT=-5
SIGNAL_CONFIRMED_PCT=2
SIGNAL_EXTENDED_PCT=5
SIGNAL_HYSTERESIS_PCT=0.25
ALERT_CONFIRM_POLLS=3

# Scheduled tracked-stock sweeps run at 09:15, 11:15, 13:15 and 15:15 IST by default.
SWEEP_INTERVAL_MINUTES=120

